{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":prHourlyLimitNone",
    "github>teutonet/renovate-config:regex-managers"
  ],
  "labels": [
    "renovate"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 4am on tuesday"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "extends": [
        "schedule:weekly"
      ],
      "automerge": true
    }
  ],
  "branchConcurrentLimit": 20,
  "prConcurrentLimit": 20
}
